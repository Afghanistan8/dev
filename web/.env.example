# The Dev console talks to exactly one contract on one chain.
#
# Copy this to .env.local and fill in the address `npm run deploy` printed.
# Nothing here is a secret: they are public addresses, compiled into the
# browser bundle on purpose.

NEXT_PUBLIC_DEV_CONTRACT=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_DEV_CHAIN_ID=61999
NEXT_PUBLIC_DEV_RPC=https://studio.genlayer.com/api
